-- Backend 1: Ultra Fast Text & GUI Scanner (Normal, Force, Screen)
local function RunTextScan(scanMode)
    WindUI:Notify({
        Title = "Scanning Text & GUIs",
        Content = "Starting " .. string.upper(scanMode) .. " scan...",
        Duration = 3
    })

    task.spawn(function()
        local character = LocalPlayer.Character
        local hrpPos = (character and character:FindFirstChild("HumanoidRootPart")) and character.HumanoidRootPart.Position or Vector3.new(0, 0, 0)
        local results = {}
        local foundMap = {}

        if scanMode == "Screen" then
            local targets = {}
            if LocalPlayer:FindFirstChild("PlayerGui") then table.insert(targets, LocalPlayer.PlayerGui) end
            pcall(function() table.insert(targets, CoreGui) end)

            local counter = 0
            for _, rootObj in ipairs(targets) do
                for _, obj in ipairs(rootObj:GetDescendants()) do
                    counter = counter + 1
                    if counter % 250 == 0 then task.wait() end

                    local isSelfGui = (textScannerScreenGui and obj:IsDescendantOf(textScannerScreenGui))
                    local isBackpack = string.find(obj.Name, "Backpack") or obj:FindFirstAncestor("Backpack") or obj:FindFirstAncestor("BackpackGui")

                    if not isSelfGui and not isBackpack and obj:IsA("GuiObject") then
                        local identifier = obj.Name
                        local extractedImg = nil
                        local fullPath = GetStructuralPath(obj)

                        if obj:IsA("ImageButton") or obj:IsA("ImageLabel") then
                            extractedImg = obj.Image
                        end

                        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                            if obj.Text ~= "" then identifier = identifier .. " (" .. obj.Text .. ")" end
                        end

                        if not foundMap[fullPath] then
                            foundMap[fullPath] = true
                            table.insert(results, {
                                Text = identifier,
                                Path = fullPath,
                                ClassName = obj.ClassName,
                                Image = extractedImg,
                                Pos3D = nil
                            })
                        end
                    end
                end
            end
        else
            local counter = 0
            for _, obj in ipairs(Workspace:GetDescendants()) do
                counter = counter + 1
                if counter % 250 == 0 then task.wait() end

                local textStr = nil
                local pos3D = Get3DPosition(obj)
                local inRange = false

                if pos3D then
                    local distance = (hrpPos - pos3D).Magnitude
                    if distance <= 50 then
                        inRange = true
                    end
                elseif scanMode == "Force" then
                    inRange = true
                end

                if inRange then
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        textStr = obj.Text
                    elseif obj:IsA("ProximityPrompt") then
                        textStr = tostring(obj.ActionText or "") .. " " .. tostring(obj.ObjectText or "")
                    elseif obj:IsA("Dialog") then
                        textStr = obj.InitialPrompt
                    end

                    if scanMode == "Force" and not textStr then
                        if obj:IsA("Humanoid") then
                            textStr = obj.DisplayName ~= "" and obj.DisplayName or obj.Parent.Name
                        elseif obj:IsA("Model") and obj.Name ~= "Workspace" and obj.Name ~= "Part" then
                            if obj.Name:match("%a+") then textStr = obj.Name end
                        end
                    end

                    if textStr and type(textStr) == "string" and textStr:gsub("%s+", "") ~= "" then
                        local fullPath = GetStructuralPath(obj)
                        if not foundMap[fullPath] then
                            foundMap[fullPath] = true
                            table.insert(results, {
                                Text = textStr,
                                Path = fullPath,
                                ClassName = obj.ClassName,
                                Image = nil,
                                Pos3D = pos3D
                            })
                        end
                    end
                end
            end
        end

        WindUI:Notify({
            Title = "Scan Complete!",
            Content = "Found " .. #results .. " text/GUI instances.",
            Duration = 3
        })

        CreateModernTextScannerUI(results, scanMode)
    end)
end

-- Backend 2: Ultra 3D Visual & Spatial Scanner (Configurable Studs, Models, Decals, Parts)
local function ExecuteSpatialScan(scanRadius)
    scanRadius = scanRadius or 40
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        WindUI:Notify({
            Title = "Scan Error",
            Content = "HumanoidRootPart not found!",
            Duration = 3
        })
        return
    end

    local rootPosition = character.HumanoidRootPart.Position

    WindUI:Notify({
        Title = "Scanning 3D Space",
        Content = "Scanning " .. tostring(scanRadius) .. " studs radius...",
        Duration = 3
    })

    task.spawn(function()
        local rangeMultiplier = Vector3.new(scanRadius, scanRadius, scanRadius)
        local minBound = rootPosition - rangeMultiplier
        local maxBound = rootPosition + rangeMultiplier
        local scanningRegion = Region3.new(minBound, maxBound)

        local overlappingParts = Workspace:FindPartsInRegion3(scanningRegion, nil, math.huge)
        local indexedPaths = {}
        local results = {}
        local loopCounter = 0

        local function processObject(target, fallbackPos)
            if not target or target == Workspace or target == game then return end

            local absolutePath = GetStructuralPath(target)
            if not indexedPaths[absolutePath] then
                indexedPaths[absolutePath] = true

                local className = target.ClassName
                local targetName = target.Name
                local targetPos = fallbackPos
                local targetSize = Vector3.new(1, 1, 1)

                if target:IsA("BasePart") then
                    targetPos = target.Position
                    targetSize = target.Size
                elseif target:IsA("Model") then
                    targetPos = target:GetPivot().Position
                    pcall(function() targetSize = target:GetExtentsSize() end)
                end

                local dist = targetPos and (rootPosition - targetPos).Magnitude or 0
                local vol = targetSize.X * targetSize.Y * targetSize.Z

                table.insert(results, {
                    Name = targetName,
                    Path = absolutePath,
                    ClassName = className,
                    Position = targetPos,
                    Size = targetSize,
                    Distance = dist,
                    Volume = vol
                })
            end
        end

        -- Phase 1: Physical Region Overlap
        for _, part in ipairs(overlappingParts) do
            loopCounter = loopCounter + 1
            if loopCounter % 200 == 0 then task.wait() end

            if not part:IsDescendantOf(character) then
                processObject(part, part.Position)
                if part.Parent and part.Parent:IsA("Model") and part.Parent ~= Workspace then
                    processObject(part.Parent, part.Position)
                end

                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("Decal") or child:IsA("Texture") or child:IsA("SpecialMesh") or child:IsA("ParticleEmitter") or child:IsA("SurfaceGui") then
                        processObject(child, part.Position)
                    end
                end
            end
        end

        -- Phase 2: Spatial Fallback for Invisible/Mesh/Decorative Assets
        local looseUniverse = Workspace:GetDescendants()
        for i = 1, #looseUniverse do
            local obj = looseUniverse[i]
            if not obj:IsDescendantOf(character) then
                if obj:IsA("SpecialMesh") or obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("Model") then
                    local objPos = nil
                    if obj:IsA("Model") then
                        objPos = obj:GetPivot().Position
                    else
                        local p = obj:FindFirstAncestorWhichIsA("BasePart")
                        if p then objPos = p.Position end
                    end

                    if objPos then
                        local dist = (rootPosition - objPos).Magnitude
                        if dist <= scanRadius then
                            loopCounter = loopCounter + 1
                            if loopCounter % 200 == 0 then task.wait() end
                            processObject(obj, objPos)
                        end
                    end
                end
            end
        end

        WindUI:Notify({
            Title = "3D Scan Complete!",
            Content = "Found " .. #results .. " visual objects within " .. tostring(scanRadius) .. " studs.",
            Duration = 3
        })

        CreateModernSpatialScannerUI(results, scanRadius)
    end)
end

