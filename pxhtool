local function fireTouch(part, toPart)
    if not part or not toPart then return end
    local isMobile = UserInputService.TouchEnabled
    firetouchinterest(part, toPart, 0)
    if isMobile then
        task.wait(0.01)
        firetouchinterest(part, toPart, 1)
    end
end

local function GetStructuralPath(instance)
    if not instance then return "Unknown Path" end
    local path = instance.Name
    local current = instance.Parent
    while current and current ~= game and current ~= nil do
        path = current.Name .. "." .. path
        current = current.Parent
    end
    return path
end

local function Get3DPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
        return obj:GetPivot().Position
    end
    if obj:IsA("Attachment") then return obj.WorldPosition end
    local parentPart = obj:FindFirstAncestorWhichIsA("BasePart")
    if parentPart then return parentPart.Position end
    return nil
end

local function MakeWindowDraggable(topbarFrame, targetFrame)
    local dragging, dragInput, dragStart, startPos
    topbarFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    topbarFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

