-- ── 8. Real-time Rolling Speed (Acceleration Rate) Engine ──
task.spawn(function()
    while true do
        task.wait(0.1)

        if currentSelectedConfig then
            local targetObj = ResolveInstanceFromPath(currentSelectedConfig.TargetPath)
            lastFoundTargetInstance = targetObj

            if targetObj and (targetObj:IsA("TextLabel") or targetObj:IsA("TextButton") or targetObj:IsA("TextBox")) then
                local rawStr, parsedVal = ExtractTargetValue(targetObj.Text, currentSelectedConfig.FormatPattern)

                if parsedVal then
                    currentRawValue = parsedVal
                    currentFormattedValue = rawStr or PXH_NumberConverter.Format(parsedVal)

                    local now = os.clock()
                    table.insert(valueHistory, { t = now, v = parsedVal })

                    -- Prune samples older than 1.2 seconds for 1-second rolling window
                    local pruned = {}
                    for _, sample in ipairs(valueHistory) do
                        if (now - sample.t) <= 1.2 then
                            table.insert(pruned, sample)
                        end
                    end
                    valueHistory = pruned

                    -- Calculate 1-Second Average Rate & Acceleration
                    if #valueHistory >= 2 then
                        local oldest = valueHistory[1]
                        local latest = valueHistory[#valueHistory]
                        local dt = latest.t - oldest.t
                        local dv = latest.v - oldest.v

                        if dt >= 0.2 then
                            currentRatePerSec = dv / dt
                        else
                            currentRatePerSec = 0
                        end

                        -- Acceleration: compare rate of first half vs second half
                        if #valueHistory >= 4 then
                            local midIdx = math.floor(#valueHistory / 2)
                            local midSample = valueHistory[midIdx]
                            local dt1 = midSample.t - oldest.t
                            local dv1 = midSample.v - oldest.v
                            local dt2 = latest.t - midSample.t
                            local dv2 = latest.v - midSample.v

                            local r1 = dt1 > 0 and (dv1 / dt1) or 0
                            local r2 = dt2 > 0 and (dv2 / dt2) or 0
                            local halfDt = (latest.t - oldest.t) / 2
                            if halfDt > 0 then
                                currentAcceleration = (r2 - r1) / halfDt
                            else
                                currentAcceleration = 0
                            end
                        else
                            currentAcceleration = 0
                        end
                    else
                        currentRatePerSec = 0
                        currentAcceleration = 0
                    end
                end
            else
                currentRatePerSec = 0
                currentAcceleration = 0
            end
        else
            currentRatePerSec = 0
            currentAcceleration = 0
        end

        UpdateStatsDisplay()
    end
end)

