                end
                SaveSpamConfigsToDisk()
                if ActiveConfigDropdown and ActiveConfigDropdown.Refresh then
                    ActiveConfigDropdown:Refresh(GetConfigNamesList())
                end
                WindUI:Notify({ Title = "Config Deleted", Content = "Deleted '" .. removedName .. "'", Duration = 3 })
                UpdateStatsDisplay()
            end
        elseif choice == "Copy selected lua code" then
            if currentSelectedConfig and currentSelectedConfig.Code then
                CopyToClipboard(currentSelectedConfig.Code)
                WindUI:Notify({ Title = "Copied!", Content = "Lua code copied to clipboard.", Duration = 3 })
