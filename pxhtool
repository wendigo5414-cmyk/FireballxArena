            pathDisplay = pathDisplay .. " (Searching...)"
        end
    end

    local rateStr = "+0.00 /s"
    if currentRatePerSec > 0 then
        rateStr = "+" .. PXH_NumberConverter.Format(currentRatePerSec) .. " /s"
    elseif currentRatePerSec < 0 then
        rateStr = "-" .. PXH_NumberConverter.Format(math.abs(currentRatePerSec)) .. " /s"
    else
        rateStr = "0.00 /s"
    end

    local trendStr = "⏸️ Stable / Idle"
    if currentAcceleration > 1 then
        trendStr = "⚡ Accelerating (+" .. PXH_NumberConverter.Format(currentAcceleration) .. " /s²)"
    elseif currentAcceleration < -1 then
        trendStr = "🔻 Decelerating (-" .. PXH_NumberConverter.Format(math.abs(currentAcceleration)) .. " /s²)"
    elseif currentRatePerSec > 0 then
        trendStr = "🟢 Steady Gain"
    end

    local statusStr = isSpamRunning and ("🚀 ACTIVE SPAMMING (" .. spamMultiplierThreads .. " Threads @ " .. spamSpeedDelay .. "s)") or "⏸️ STOPPED"

    local descText = string.format(
        "Config: %s\nTarget Path: %s\nPattern: %s\n\n📌 Current Target (X): %s  (Raw: %s)\n📈 1-Sec Gain Rate: %s\n🚀 Dynamics: %s\n⚙️ Runner Status: %s",
        cfgName,
        pathDisplay,
        currentSelectedConfig and currentSelectedConfig.FormatPattern or "X",
        tostring(currentFormattedValue),
        PXH_NumberConverter.Format(currentRawValue),
        rateStr,
        trendStr,
        statusStr
    )

    pcall(function()
        if StatsParagraph.SetDesc then
            StatsParagraph:SetDesc(descText)
        elseif StatsParagraph.Set then
            StatsParagraph:Set({
                Title = "📊 Target Stats & Rate Monitor",
                Desc = descText
            })
        end
    end)
end

