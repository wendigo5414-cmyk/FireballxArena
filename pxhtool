local PXH_NumberConverter = {}

function PXH_NumberConverter.Format(value)
    local number = tonumber(value)
    if not number then return tostring(value or 0) end
    if number < 0 then
        return "-" .. PXH_NumberConverter.Format(-number)
    end
    if number < 1000 then
        if math.floor(number) == number then
            return tostring(number)
        else
            return string.format("%.2f", number)
        end
    end

    local suffixIndex = math.floor(math.log10(number) / 3)
    local shortValue = number / (10 ^ (suffixIndex * 3))

    if suffixIndex > 0 and suffixIndex <= #PXH_ExtendedSuffixes then
        return string.format("%.2f%s", shortValue, PXH_ExtendedSuffixes[suffixIndex])
    else
        return string.format("%.2e", number)
    end
end

function PXH_NumberConverter.Parse(str)
    if type(str) == "number" then return str end
    if not str then return 0 end
    str = tostring(str)
    str = string.gsub(str, "<[^>]+>", "")
    str = string.gsub(str, ",", "")

    local slashPos = string.find(str, "/")
    if slashPos then
        str = string.sub(str, 1, slashPos - 1)
    end

    str = string.upper(str)
    for _, noise in ipairs({"WINS", "REQUIRED", "COST", "PRICE", "NEEDED", "STRENGTH", "COINS", "LEVEL", "XP", "ENERGY", "GEMS"}) do
        str = string.gsub(str, noise, "")
    end
    str = string.gsub(str, "[^%d%.A-Z]", "")

    local numberPart = string.match(str, "^[%d%.]+")
    local suffixPart = string.match(str, "[A-Z]+$")
    if not numberPart then return 0 end
    local number = tonumber(numberPart) or 0
    if suffixPart then
        if suffixPart == "QT" then suffixPart = "QI" end
        if suffixPart == "QD" then suffixPart = "QA" end
        for i, suffix in ipairs(PXH_ExtendedSuffixes) do
            if string.upper(suffix) == suffixPart then
                return number * (10 ^ (i * 3))
            end
        end
    end
    return number
end

-- ── 2. Structural & Smart Instance Path Resolver ──
local function ResolveInstanceFromPath(pathStr)
    if not pathStr or type(pathStr) ~= "string" or pathStr:gsub("%s+", "") == "" then
        return nil
    end

    local cleanPath = pathStr
    cleanPath = cleanPath:gsub('^game:GetService%("([^"]+)"%)', "%1")
    cleanPath = cleanPath:gsub('^game:GetService%\'([^\']+)\'%)', "%1")
    cleanPath = cleanPath:gsub('^game%.', "")

    local segments = {}
    for seg in string.gmatch(cleanPath, "[^%.%[%]\"]+") do
        if seg ~= "game" and seg ~= "GetService" and seg ~= "" then
            table.insert(segments, seg)
        end
    end

    local current = nil
    if segments[1] == "LocalPlayer" or segments[1] == "Players" then
        if segments[1] == "Players" and segments[2] == "LocalPlayer" then
            current = LocalPlayer
            for i = 3, #segments do
                if current and current:FindFirstChild(segments[i]) then
                    current = current:FindFirstChild(segments[i])
                else
                    current = nil
                    break
                end
            end
        elseif segments[1] == "LocalPlayer" then
            current = LocalPlayer
            for i = 2, #segments do
                if current and current:FindFirstChild(segments[i]) then
                    current = current:FindFirstChild(segments[i])
                else
                    current = nil
                    break
                end
            end
        end
    elseif segments[1] == "Workspace" or segments[1] == "workspace" then
        current = Workspace
        for i = 2, #segments do
            if current and current:FindFirstChild(segments[i]) then
                current = current:FindFirstChild(segments[i])
            else
                current = nil
                break
            end
        end
    elseif segments[1] == "PlayerGui" then
        current = LocalPlayer:FindFirstChild("PlayerGui")
        for i = 2, #segments do
            if current and current:FindFirstChild(segments[i]) then
                current = current:FindFirstChild(segments[i])
            else
                current = nil
                break
            end
        end
    end

    if current and (current:IsA("TextLabel") or current:IsA("TextButton") or current:IsA("TextBox")) then
        return current
    end

    -- Deep name fallback in PlayerGui and Workspace
    local searchName = segments[#segments] or pathStr
    if LocalPlayer:FindFirstChild("PlayerGui") then
        for _, desc in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if desc.Name == searchName and (desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox")) then
                return desc
            end
        end
    end

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == searchName and (desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox")) then
            return desc
        end
    end

    return nil
end

-- ── 3. Target Pattern Matcher (Target X vs Ignore variables a, y, z) ──
local function ExtractTargetValue(textStr, formatPattern)
    if not textStr or type(textStr) ~= "string" then
        return nil, 0
    end

    -- Clean rich text tags first
    local cleanText = string.gsub(textStr, "<[^>]+>", "")

    -- If pattern is empty or simple X, find first number + suffix
    if not formatPattern or formatPattern:gsub("%s+", "") == "" or formatPattern:gsub("%s+", "") == "X" then
        local rawMatch = string.match(cleanText, "[%d%,%.]+%s*[A-Za-z]*")
        if rawMatch then
            local cleanStr = rawMatch:gsub(",", ""):gsub("%s+", "")
            local parsedNum = PXH_NumberConverter.Parse(cleanStr)
            return rawMatch, parsedNum
        end
        return nil, 0
    end

    -- Escape Lua magic characters except 'X' and single lowercase letters
    local specialChars = { "%.", "%(", "%)", "%+", "%-", "%*", "%?", "%[", "%]", "%^", "%$", "%%" }
    local escaped = ""
    for i = 1, #formatPattern do
        local c = string.sub(formatPattern, i, i)
        local isSpecial = false
        for _, sp in ipairs({ ".", "(", ")", "+", "-", "*", "?", "[", "]", "^", "$", "%" }) do
            if c == sp then
                isSpecial = true
                break
            end
        end
        if isSpecial then
            escaped = escaped .. "%" .. c
        else
            escaped = escaped .. c
        end
    end

    -- Replace single lowercase letters (variables like a, y, z) with ignore patterns [^%s/%,%)]+
    escaped = string.gsub(escaped, "%f[%a]([a-z])%f[%A]", "[^%%s%%/%%,%%)%%]]+")

    -- Replace 'X' with capture group for number and suffixes
    escaped = string.gsub(escaped, "X", "([%%d%%,%%.]+%%s*[A-Za-z]*)")

    local okMatch, captured = pcall(function()
        return string.match(cleanText, escaped)
    end)

    if okMatch and captured then
        local cleanStr = captured:gsub(",", ""):gsub("%s+", "")
        local parsedNum = PXH_NumberConverter.Parse(cleanStr)
        return captured, parsedNum
    end

    -- Graceful fallback: extract first valid number with suffix
    local fallback = string.match(cleanText, "[%d%,%.]+%s*[A-Za-z]*")
    if fallback then
        local cleanStr = fallback:gsub(",", ""):gsub("%s+", "")
        local parsedNum = PXH_NumberConverter.Parse(cleanStr)
        return fallback, parsedNum
    end

    return nil, 0
end

