        "Create spam code",
        "Edit selected config",
        "Delete selected config",
        "Copy selected lua code"
    },
    Value = "Create spam code",
    Callback = function(choice)
        if choice == "Create spam code" then
            OpenCreateSpamCodeUI()
        elseif choice == "Edit selected config" then
            if currentSelectedConfig then
                OpenCreateSpamCodeUI(currentSelectedConfig)
            else
                WindUI:Notify({ Title = "No Config", Content = "Create or select a config first.", Duration = 3 })
            end
        elseif choice == "Delete selected config" then
            if currentSelectedConfig and #PXH_CreatedSpamConfigs > 0 then
                local removedName = currentSelectedConfig.Name
                table.remove(PXH_CreatedSpamConfigs, selectedConfigIndex)
                if #PXH_CreatedSpamConfigs > 0 then
                    selectedConfigIndex = 1
                    currentSelectedConfig = PXH_CreatedSpamConfigs[1]
                else
